# Copy to app/.env for local runs. All optional. With none of these set, the app runs in local mode:
# scripted caller, keyword Analyst, browser speech in and out, everything in memory.

# --- Mode -------------------------------------------------------------------
# aws | local. Auto-detected from credentials if unset.
CB_MODE=aws

# --- AWS credentials (local runs only; on Fargate the task role is used) -----
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Bedrock ------------------------------------------------------------------
# Red agent (the caller). Claude Sonnet for quality; switch to amazon.nova-pro-v1:0 to cut cost ~70%.
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-20250514-v1:0
# Analyst + world builder. Small and fast.
BEDROCK_ANALYST_MODEL_ID=anthropic.claude-haiku-4-5-20251001-v1:0
# If Bedrock models are not enabled in ap-south-1 on your account, point this at us-east-1.
BEDROCK_REGION=ap-south-1
# Optional Guardrail attached to the red agent.
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT

# --- Transcribe / Polly ---------------------------------------------------------
TRANSCRIBE_ENABLED=true
POLLY_ENABLED=true
POLLY_VOICE_EN=Kajal
POLLY_VOICE_HI=Kajal
POLLY_ENGINE=neural

# --- Data / pipeline (set automatically by the CDK stack on Fargate) ------------
DDB_TABLE=
S3_PACKET_BUCKET=
EVENT_BUS_NAME=

# --- Safety valves ----------------------------------------------------------------
DRILL_CAP=200
# TRIP_THRESHOLD=70
