# Copy to app/.env for local runs. All optional. With none of these set, the app runs in local mode:
# scripted caller, keyword Analyst, browser speech in and out, everything in memory.

# --- Mode -------------------------------------------------------------------
# aws | local. Auto-detected from credentials if unset.
CB_MODE=aws

# --- AWS credentials (local runs only; on Fargate the task role is used) -----
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Bedrock ------------------------------------------------------------------
# Red agent (the caller). Claude Sonnet for quality; switch to amazon.nova-pro-v1:0 to cut cost ~70%.
BEDROCK_MODEL_ID=openai.gpt-oss-120b-1:0   # open-weight, no use-case form. Claude: apac.anthropic.claude-sonnet-4-20250514-v1:0 (needs the Anthropic form)
# Analyst + world builder. Small and fast.
BEDROCK_ANALYST_MODEL_ID=amazon.nova-lite-v1:0   # or global.anthropic.claude-haiku-4-5-20251001-v1:0
# If Bedrock models are not enabled in ap-south-1 on your account, point this at us-east-1.
BEDROCK_REGION=ap-south-1
# Optional Guardrail attached to the red agent.
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT

# --- Transcribe / Polly ---------------------------------------------------------
TRANSCRIBE_ENABLED=true
POLLY_ENABLED=true
POLLY_VOICE_EN=Kajal          # female callers, en-IN
POLLY_VOICE_EN_MALE=Matthew   # male callers (Polly has no male en-IN neural voice); Brian is the fallback
POLLY_VOICE_HI=Kajal
POLLY_ENGINE=neural

# --- Data / pipeline (set automatically by the CDK stack on Fargate) ------------
DDB_TABLE=
S3_PACKET_BUCKET=
EVENT_BUS_NAME=

# --- Safety valves ----------------------------------------------------------------
DRILL_CAP=200
# TRIP_THRESHOLD=70

# --- Caller brain: OpenAI-compatible endpoint (OpenRouter, Groq, llama.cpp) --------
# LLM_PROVIDER=auto        # auto = Bedrock when it answers, else this endpoint · openai = always this endpoint · bedrock = Bedrock only
# LLM_BASE_URL=https://openrouter.ai/api/v1      # or https://api.groq.com/openai/v1, or http://127.0.0.1:8081/v1 for tools/llm/serve.sh
# LLM_MODEL=deepseek/deepseek-v4-flash            # the caller (smart tier)
# LLM_ANALYST_MODEL=deepseek/deepseek-v4-flash    # Analyst tags, world builder, page copy (fast tier); a :free model works here
# LLM_API_KEY=                                    # on Fargate this comes from the Secrets Manager secret circuit-breaker/llm, never from here
# LLM_MAX_IN_FLIGHT=6                             # concurrent requests to the endpoint; extra callers queue
# Voice: tools/piper/install.sh installs Piper (caller voice, en/hi) and Vosk (your mic, en-IN/hi) — no keys needed.
